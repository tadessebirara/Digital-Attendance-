# ─────────────────────────────────────────────────────────────────────────────
# Alyah Smart Attendance — Backend Environment Configuration
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                       cp .env.example .env      (Mac/Linux)
#   2. Fill in all values marked with <...>
#   3. Generate secrets with:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   4. NEVER commit .env to git — it is gitignored
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: Full connection URL (Render, Heroku, Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: Individual fields (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alyah_smart_attendance
DB_USER=postgres
DB_PASSWORD=<your-postgres-password>

# ── Security — REQUIRED (server refuses to start without these) ───────────────
# Run this twice to get two different secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<64-char-random-string>
JWT_EXPIRES_IN=8h
DEVICE_SECRET=<64-char-random-string-different-from-jwt>

# Refresh token lifetime in minutes (10080 = 7 days recommended for mobile)
REFRESH_EXPIRES_MINUTES=10080

# ── Seed endpoint secret (used to populate DB on first deploy) ────────────────
SEED_SECRET=<any-secret-string-you-choose>

# ── Frontend URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
MOBILE_DEEP_LINK_URL=alyah://reset-password
MOBILE_VERIFY_EMAIL_URL=alyah://verify-email

# ── CORS — comma-separated allowed origins ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Redis (optional — needed for multi-instance Socket.IO scaling) ────────────
# REDIS_URL=redis://localhost:6379

# ── Email (SMTP) — required for OTP emails and password reset ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASS=<your-gmail-app-password>
SMTP_FROM=Alyah Smart Attendance <noreply@yourdomain.com>
# Gmail app password: Google Account → Security → 2-Step → App passwords

# ── Firebase Cloud Messaging (optional — for push notifications) ──────────────
# Leave blank to disable push notifications
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
# Public URL of this server — used to build file URLs returned to clients
# In production set to: https://your-api-domain.com
BASE_URL=http://localhost:5000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ── Company branding ──────────────────────────────────────────────────────────
COMPANY_NAME=Alyah Smart Attendance
COMPANY_LOGO_URL=

# ── Dev/testing overrides (never set in production) ──────────────────────────
# APP_ENV=development
# DEV_MODE=true
# ALLOW_EMULATOR=true
# ALLOW_MULTI_LOGIN_TESTING=true
